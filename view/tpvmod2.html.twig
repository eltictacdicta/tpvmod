{#
/**
 * Plugin: tpvmod
 * Pantalla principal del TPV para crear un documento nuevo (línea editor +
 * modal de guardado + selector de artículos). Es la "vista de venta"
 * que se renderiza dentro de tpvmod.html cuando hay caja abierta.
 * Twig nativo (no depende de legacy_support).
 * Migrado desde view/tpvmod2.html el 2026-07-18.
 */
#}
<link rel="stylesheet" href="plugins/tpvmod/view/css/tpvmod.css?v={{ fsc.today() }}"/>
<script type="text/javascript" src="plugins/tpvmod/view/js/tpvmod.js?v={{ fsc.today() }}"></script>
<script type="text/javascript">
   fs_nf0 = typeof FS_NF0 !== 'undefined' ? FS_NF0 : 2;
   tpv_url = '{{ fsc.url()|raw }}';
   nueva_venta_url = tpv_url;
   cliente = {{ json_encode(fsc.cliente_tpv_json())|raw }};
   all_impuestos = {{ json_encode(fsc.impuestos_tpv_json())|raw }};
   all_series = {{ json_encode(fsc.serie.all())|raw }};
   tpvmod_divisas = {
      {% for divisa in fsc.divisa.all() %}
      '{{ divisa.coddivisa|e('js') }}': '{{ divisa.simbolo|e('js') }}'{% if not loop.last %},{% endif %}
      {% endfor %}
   };
   if(typeof all_impuestos === 'string') {
      try { all_impuestos = JSON.parse(all_impuestos); } catch(e) { all_impuestos = []; }
   }
   if(!Array.isArray(all_impuestos)) {
      all_impuestos = [];
   }

   $(document).ready(function() {
      tpvmod_init_tpv_calculos();
   });
</script>



<div class="container-fluid" style="margin-top: 10px; margin-bottom: 10px;">
   <div class="row">
      <div class="col-xs-6">
         <div class="btn-group hidden-xs">
            <a class="btn btn-sm btn-default" href="{{ fsc.url()|raw }}" title="recargar la página">
               <span class="glyphicon glyphicon-refresh"></span>
            </a>
            {% if fsc.page.show_on_menu %}
               {% if fsc.page.is_default() %}
               <a class="btn btn-sm btn-default active" href="{{ fsc.url()|raw }}&amp;default_page=FALSE" title="desmarcar como página de inicio">
                  <span class="glyphicon glyphicon-home"></span>
               </a>
               {% else %}
               <a class="btn btn-sm btn-default" href="{{ fsc.url()|raw }}&amp;default_page=TRUE" title="marcar como página de inicio">
                  <span class="glyphicon glyphicon-home"></span>
               </a>
               {% endif %}
            {% endif %}
         </div>

            <div class="btn-group">
                <a href="./index.php?page=tpvmod_presupuestos"  class="btn btn-sm btn-default">
                       <span class="glyphicon glyphicon-list-alt"></span>
                       <span class="hidden-xs">&nbsp; Presupuestos</span>
                    </a>
                <a href="./index.php?page=tpvmod_pedidos"  class="btn btn-sm btn-default">
                       <span class="glyphicon glyphicon-list-alt"></span>
                       <span class="hidden-xs">&nbsp; Pedidos</span>
                    </a>
                <a href="./index.php?page=tpvmod_albaranes"  class="btn btn-sm btn-default">
                       <span class="glyphicon glyphicon-list-alt"></span>
                       <span class="hidden-xs">&nbsp; Albarenes</span>
                    </a>
                <a href="./index.php?page=tpvmod_facturas"  class="btn btn-sm btn-default">
                       <span class="glyphicon glyphicon-list-alt"></span>
                       <span class="hidden-xs">&nbsp; Facturas</span>
                    </a>


            </div>
      </div>
       <div class="col-xs-3 text-center">
        <h4>Nuevo documento</h4>
      </div>
      <div class="col-xs-3 text-right">
        {% if fsc.caja_module_enabled %}
        <a href="#" id="b_cerrar_caja" class="btn btn-sm btn-danger">
               <span class="glyphicon glyphicon-lock"></span> &nbsp; Cerrar caja
        </a>
        {% endif %}
      </div>
   </div>
</div>

<form id="f_tpv" name="f_tpv" action="{{ fsc.url()|raw }}" method="post" class="form">
   {{ csrf_field() }}
   <input type="hidden" name="petition_id" value="{{ fsc.random_string() }}"/>
   <input type="hidden" id="numlineas" name="numlineas" value="0"/>
   <input type="hidden" id="tpv_total2" name="tpv_total2" value="0"/>
   <input type="hidden" name="cliente" value="{{ fsc.cliente_s.codcliente }}"/>
   <div class="container-fluid">
      <div class="row">
         <div class="col-sm-6">
            <div class="form-group">
               Cliente:
               <div class="input-group">
                  <input class="form-control input-sm" type="text" name="ac_cliente" id="ac_cliente" value="{{ fsc.cliente_s.nombre }} Tlf:{{ fsc.cliente_s.telefono1 }} Tlf2:{{ fsc.cliente_s.telefono2 }}" placeholder="Buscar" autocomplete="off" readonly="readonly"/>
                  <span class="input-group-btn">
                     <button class="btn btn-sm btn-default tpvmod-b-buscar-cliente" type="button" title="Buscar cliente">
                        <span class="glyphicon glyphicon-edit"></span>
                     </button>
                  </span>
               </div>
               <p class="help-block">
                  <a href="#" class="tpvmod-b-editar-cliente">Editar cliente</a>
                  ·
                  <a href="#" class="tpvmod-b-nuevo-cliente">Nuevo cliente</a>
               </p>
            </div>
         </div>
         <div class="col-sm-3">
            <div class="form-group">
               Fecha:
               <input class="form-control input-sm" type="text" name="fecha" value="{{ fsc.today() }}" readonly="">
            </div>
         </div>
         <div class="col-sm-3">
            <div class="form-group">
               Atiende:
               <div class="form-control input-sm">
                  <a href="{{ fsc.agente.url()|raw }}">{{ fsc.agente.get_fullname() }}</a>
               </div>
            </div>
         </div>
      </div>
   </div>

   <ul class="nav nav-tabs" role="tablist">
      <li class="active">
         <a href="#tab_lineas" role="tab" data-toggle="tab">
            <span class="glyphicon glyphicon-list" aria-hidden="true"></span>
            <span class="hidden-xs">&nbsp; Líneas</span>
         </a>
      </li>
      <li>
         <a href="#tab_opciones" role="tab" data-toggle="tab">
            <span class="glyphicon glyphicon-wrench" aria-hidden="true"></span>
            <span class="hidden-xs">&nbsp; Opciones</span>
         </a>
      </li>
   </ul>

   <div class="tab-content">
      <div class="tab-pane active" id="tab_lineas">
         <div class="table-responsive">
            <table class="table table-condensed">
               <thead>
                   <th style="width:60px">Ref</th>
                   <th class="text-left">Artículo</th>
                   <th class="text-right" style="width:50px">Cantidad</th>
                   <th style="width:60px" title="Arrastrar o eliminar"></th>
                   <th class="text-right" style="width:80px">Precio</th>
                   <th class="text-right" style="width:80px">Neto</th>
                   <th class="text-right" style="width:90px">{% if defined('FS_IVA') %}{{ constant('FS_IVA') }}{% endif %}</th>
                   <th class="text-right recargo" style="width:70px; display:none;">R.E.</th>
                   <th class="text-right irpf" style="width:70px; display:none;">{% if defined('FS_IRPF') %}{{ constant('FS_IRPF') }}{% else %}IRPF{% endif %}</th>
                   <th class="text-right" style="width:90px">Total</th>
               </thead>
               <tbody id="lineas_albaran">
                  <tr class="bg-info">
                     <td><input id="i_new_line" class="form-control input-sm" type="text" placeholder="Buscar para añadir..." autocomplete="off"/></td>
                     <td>
                           <a href="#" class="btn btn-sm btn-default" title="Añadir sin buscar" onclick="return add_linea_libre()">
                              <span class="glyphicon glyphicon-edit" aria-hidden="true"></span>
                           </a>
                     </td>
                     <td colspan="3" class="text-right">Totales:</td>
                     <td><div id="aneto" class="form-control text-right input-sm" style="font-weight: bold;">{{ fsc.show_numero(0) }}</div></td>
                     <td><div id="aiva" class="form-control text-right input-sm" style="font-weight: bold;">{{ fsc.show_numero(0) }}</div></td>
                     <td class="recargo" style="display:none;"><div id="are" class="form-control text-right input-sm" style="font-weight: bold;">{{ fsc.show_numero(0) }}</div></td>
                     <td class="irpf" style="display:none;"><div id="airpf" class="form-control text-right input-sm" style="font-weight: bold;">{{ fsc.show_numero(0) }}</div></td>
                     <td><div id="atotal" class="form-control text-right input-sm" style="font-weight: bold;">{{ fsc.show_numero(0) }}</div></td>
                  </tr>
               </tbody>
            </table>
            <p class="help-block hidden-xs">
               <i class="fa fa-arrows-v"></i> Arrastra el icono de flechas para reordenar las líneas.
            </p>
         </div>
      </div>
      <div class="tab-pane" id="tab_opciones">
         {% if fsc.terminal %}
         <input type="hidden" name="almacen" value="{{ fsc.terminal.codalmacen }}"/>
         <input type="hidden" name="serie" value="{{ fsc.terminal.codserie }}"/>
         {% endif %}
         <div class="container-fluid" style="margin-top: 10px; margin-bottom: 20px;">
            <div class="row">
               {% if not fsc.terminal %}
               <div class="col-sm-3">
                  <div class="form-group">
                     <a href="{{ fsc.almacen.url()|raw }}">Almacén</a>:
                     <select name="almacen" class="form-control input-sm">
                        {% for almacen in fsc.almacen.all() %}
                           {% if almacen.is_default() %}
                           <option value="{{ almacen.codalmacen }}" selected='selected'>{{ almacen.nombre }}</option>
                           {% else %}
                           <option value="{{ almacen.codalmacen }}">{{ almacen.nombre }}</option>
                           {% endif %}
                        {% endfor %}
                     </select>
                  </div>
               </div>
               <div class="col-sm-3">
                  <div class="form-group">
                     <a href="{{ fsc.serie.url()|raw }}">Serie</a>:
                     <select name="serie" class="form-control input-sm" id="codserie" onchange="usar_serie();recalcular();">
                        {% for serie in fsc.serie.all() %}
                           {% if serie.is_default() %}
                           <option value="{{ serie.codserie }}" selected='selected'>{{ serie.descripcion }}</option>
                           {% else %}
                           <option value="{{ serie.codserie }}">{{ serie.descripcion }}</option>
                           {% endif %}
                        {% endfor %}
                     </select>
                  </div>
               </div>
               {% endif %}
               <div class="col-sm-3">
                  <div class="form-group">
                     <a href="{{ fsc.divisa.url()|raw }}">Divisa</a>:
                     <select name="divisa" class="form-control input-sm">
                        {% for divisa in fsc.divisa.all() %}
                           {% if divisa.is_default() %}
                           <option value="{{ divisa.coddivisa }}" selected="selected">{{ divisa.descripcion }}</option>
                           {% else %}
                           <option value="{{ divisa.coddivisa }}">{{ divisa.descripcion }}</option>
                           {% endif %}
                        {% endfor %}
                     </select>
                  </div>
               </div>
               <div class="col-sm-3">
                  <div class="form-group">
                     Número 2:
                     <input class="form-control input-sm" type="text" name="numero2" autocomplete="off"/>
                  </div>
               </div>
            </div>
         </div>
      </div>

   </div>

   <div class="container-fluid">
      <div class="row" style="margin-bottom: 30px;">
         <div class="col-xs-6">
            <button class="btn btn-sm btn-default" type="button" onclick="window.location.href='{{ fsc.url()|raw }}';">
               <span class="glyphicon glyphicon-refresh"></span> &nbsp; Reiniciar...
            </button>
         </div>
         <div class="col-xs-6 text-right">
            <button type="button" id="b_tpv_guardar" class="btn btn-sm btn-primary">
               <span class="glyphicon glyphicon-floppy-disk"></span> &nbsp; Guardar...
            </button>
         </div>
      </div>
      <div class="row">
         <div class="col-xs-12">
            <div class="form-group">
               Observaciones:
               <textarea class="form-control input-sm" name="observaciones" rows="4"></textarea>
            </div>
         </div>
      </div>
   </div>

   <div class="modal" id="modal_guardar" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
      <div class="modal-dialog">
         <div class="modal-content">
            <div class="modal-header">
               <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                  <span aria-hidden="true">&times;</span>
               </button>
               <h4 class="modal-title" id="myModalLabel">Guardar documento</h4>
            </div>
            <div class="modal-body">
               <div class="form-group col-md-6">
               <div class="form-group">
                  Total:
                  <input type="text" name="tpv_total" id="tpv_total" class="form-control input-sm" disabled="disabled"/>
               </div>
               <div class="form-group">
                  Efectivo:
                  <input type="text" name="tpv_efectivo" id="tpv_efectivo" class="form-control input-sm" onkeyup="recalcular()" autocomplete="off"/>
               </div>
               <div class="form-group">
                  Cambio:
                  <input type="text" name="tpv_cambio" id="tpv_cambio" class="form-control input-sm" disabled="disabled"/>
               </div>
               </div>
               {% for tipo in fsc.tipos_a_guardar() %}
               <div class="radio col-md-6">
                  <label>
                     <input type="radio" name="tipo" value="{{ tipo.tipo }}"/>
                     {{ tipo.nombre }}
                  </label>
               </div>
               {% endfor %}
               <div class="form-group col-md-12">
                  <a href="{{ fsc.forma_pago.url()|raw }}">Forma de pago</a>:
                  <select name="forma_pago" class="form-control input-sm">
                  {% for fp in fsc.forma_pago.all() %}
                     {% if fp.is_default() %}
                     <option value="{{ fp.codpago }}" selected="selected">{{ fp.descripcion }}</option>
                     {% else %}
                     <option value="{{ fp.codpago }}">{{ fp.descripcion }}</option>
                     {% endif %}
                  {% endfor %}
                  </select>
               </div>
            </div>
            <div class="modal-footer">
               <div class="form-group col-md-12">
               <button class="btn btn-sm btn-primary" type="submit" onclick="return tpvmod_submit_guardar(this);">
                  <span class="glyphicon glyphicon-floppy-disk"></span> &nbsp; Guardar
               </button>
               </div>
            </div>
         </div>
      </div>
   </div>
</form>

<div class="modal" id="modal_articulos">
   <div class="modal-dialog" style="width: 99%; max-width: 950px;">
      <div class="modal-content">
         <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h4 class="modal-title">Buscar artículos</h4>
         </div>
         <div class="modal-body">
            <form id="f_buscar_articulos" name="f_buscar_articulos" action="{{ fsc.url()|raw }}" method="post" class="form">
               {{ csrf_field() }}
               <input type="hidden" name="codcliente"/>
               <div class="container-fluid">
                  <div class="row">
                     <div class="col-lg-6 col-md-6 col-sm-6">
                        <div class="input-group">
                           <input class="form-control input-sm" type="text" name="query" autocomplete="off"/>
                           <span class="input-group-btn">
                              <button class="btn btn-sm btn-primary" type="submit">
                                 <span class="glyphicon glyphicon-search"></span>
                              </button>
                           </span>
                        </div>
                        <label>
                           <input type="checkbox" name="con_stock" value="TRUE" onchange="buscar_articulos()"/>
                           sólo con stock
                        </label>
                        <label>
                           <input type="checkbox" name="con_stock" value="TRUE" onchange="buscar_articulos()"/>
                           sólo con stock virtual
                        </label>
                     </div>
                     <div class="col-lg-6 col-md-6 col-sm-6">
                        <select class="form-control input-sm" name="codfamilia" onchange="buscar_articulos()">
                           <option value="">Todas las familias</option>
                           <option value="">------</option>
                           {% for familia in fsc.familia.all() %}
                           <option value="{{ familia.codfamilia }}">{{ familia.descripcion }}</option>
                           {% endfor %}
                        </select>
                     </div>
                  </div>
               </div>
            </form>
         </div>
         <div id="search_results"></div>
      </div>
   </div>
</div>

{% include 'partials/modal_clientes.html.twig' %}

<div class="modal fade" id="modal_opcionales" tabindex="-1" role="dialog">
   <div class="modal-dialog" role="document">
      <div class="modal-content">
         <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h4 class="modal-title">Añadir opcional</h4>
         </div>
         <div class="modal-body" id="tpvmod_opcionales_list">
            <p class="text-muted">Selecciona un opcional para añadirlo a la línea del producto.</p>
         </div>
         <div class="modal-footer">
            <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
         </div>
      </div>
   </div>
</div>
