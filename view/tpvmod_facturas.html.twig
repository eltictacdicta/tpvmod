{#
/**
 * Plugin: tpvmod
 * Listado de facturas generadas por el TPV. Paginado, con búsqueda
 * por cliente / serie / agente / fecha y modal de búsqueda de líneas.
 * Twig nativo (no depende de legacy_support).
 * Migrado desde view/tpvmod_facturas.html el 2026-07-18.
 */
#}
{% import 'Macro/Htmx.html.twig' as htmx %}
{% import 'Macro/Alpine.html.twig' as alpine %}
{% include 'header.html.twig' %}

{# htmx 4 boot with allowScriptTags:false so swapped fragments are scrubbed
   (HCS-04/05/12). The macro is the only htmx loading point in this view. #}
{{ htmx.boot({'allowScriptTags': false}) }}

<script type="text/javascript">
   $(document).ready(function() {

      {% if fsc.mostrar == 'buscar' %}
      document.f_custom_search.query.focus();
      {% endif %}
   });
</script>

<div class="container-fluid" style="margin-top: 10px; margin-bottom: 10px;">
   <div class="row">
      <div class="col-sm-8 col-xs-6">
         <a class="btn btn-sm btn-default" href="./index.php?page=tpvmod" title="Ir al tpv">
               <span class="glyphicon glyphicon-circle-arrow-left"></span>
      </a>
         <div class="btn-group hidden-xs">
            <a class="btn btn-sm btn-default" href="{{ fsc.url()|raw }}" title="Recargar la página">
               <span class="glyphicon glyphicon-refresh"></span>
            </a>
            {% if fsc.page.is_default() %}
            <a class="btn btn-sm btn-default active" href="{{ fsc.url()|raw }}&amp;default_page=FALSE" title="desmarcar como página de inicio">
               <span class="glyphicon glyphicon-home"></span>
            </a>
            {% else %}
            <a class="btn btn-sm btn-default" href="{{ fsc.url()|raw }}&amp;default_page=TRUE" title="marcar como página de inicio">
               <span class="glyphicon glyphicon-home"></span>
            </a>
            {% endif %}
         </div>
         <div class="btn-group">
            <a class="btn btn-sm btn-success" href="index.php?page=tpvmod">
               <span class="glyphicon glyphicon-plus"></span>
               <span class="hidden-xs">&nbsp; Nueva</span>
            </a>
            {% if fsc.huecos %}
            <button class="btn btn-sm btn-default" data-toggle="modal" data-target="#modal_huecos">
               <span class="glyphicon glyphicon-exclamation-sign"></span> &nbsp; Huecos
            </button>
            {% endif %}
            {% for value in fsc.extensions %}
               {% if value.type == 'button' %}
               <a href="index.php?page={{ value.from }}{{ value.params }}" class="btn btn-sm btn-default">{{ value.text|raw }}</a>
               {% endif %}
            {% endfor %}
         </div>
      </div>
      <div class="col-sm-4 col-xs-6 text-right">
         <a id="b_buscar_lineas" class="btn btn-sm btn-info" title="Buscar en las líneas"
            data-toggle="modal" data-target="#modal_buscar_lineas">
            <span class="glyphicon glyphicon-search"></span> &nbsp; Líneas
         </a>
      </div>
   </div>
</div>

{% if fsc.mostrar == 'buscar' %}
<br/>
<form name="f_custom_search" action="{{ fsc.url()|raw }}" method="get" class="form"
      hx-get="{{ fsc.url() }}" hx-target="#tpvmod-facturas-region"
      hx-select="#tpvmod-facturas-region" hx-swap="outerHTML"
      hx-push-url="true" hx-trigger="submit">
   <input type="hidden" name="mostrar" value="buscar"/>
   <input type="hidden" name="order" value="{{ fsc.order|lower|replace({' ': '_'}) }}"/>
   {% if fsc.cliente %}
   <input type="hidden" name="codcliente" value="{{ fsc.cliente.codcliente }}"/>
   {% else %}
   <input type="hidden" name="codcliente"/>
   {% endif %}
   <div class="container-fluid">
      <div class="row">
         <div class="col-sm-2">
            <div class="form-group">
               <div class="input-group">
                  <input class="form-control" type="text" name="query" value="{{ fsc.query }}" autocomplete="off" placeholder="Buscar">
                  <span class="input-group-btn">
                     <button class="btn btn-primary hidden-sm" type="submit">
                        <span class="glyphicon glyphicon-search"></span>
                     </button>
                  </span>
               </div>
            </div>
         </div>
         <div class="col-sm-2">
            <div class="form-group">
                <select class="form-control" name="codserie"
                        hx-get="{{ fsc.list_url({'mostrar': 'buscar', 'offset': 0}, ['codserie']) }}"
                        hx-target="#tpvmod-facturas-region" hx-select="#tpvmod-facturas-region"
                        hx-swap="outerHTML" hx-push-url="true" hx-trigger="change">
                  <option value="">Cualquier serie</option>
                  <option value="">-----</option>
                  {% for value in fsc.serie.all() %}
                     {% if value.codserie == fsc.codserie %}
                     <option value="{{ value.codserie }}" selected="">{{ value.descripcion }}</option>
                     {% else %}
                     <option value="{{ value.codserie }}">{{ value.descripcion }}</option>
                     {% endif %}
                  {% endfor %}
               </select>
            </div>
         </div>
         <div class="col-sm-2">
            <div class="form-group">
                <select name="codagente" class="form-control"
                        hx-get="{{ fsc.list_url({'mostrar': 'buscar', 'offset': 0}, ['codagente']) }}"
                        hx-target="#tpvmod-facturas-region" hx-select="#tpvmod-facturas-region"
                        hx-swap="outerHTML" hx-push-url="true" hx-trigger="change">
                  <option value="">Cualquier empleado</option>
                  <option value="">------</option>
                  {% for value in fsc.agente.all() %}
                     {% if value.codagente == fsc.codagente %}
                     <option value="{{ value.codagente }}" selected="">{{ value.get_fullname() }}</option>
                     {% else %}
                     <option value="{{ value.codagente }}">{{ value.get_fullname() }}</option>
                     {% endif %}
                  {% endfor %}
               </select>
            </div>
         </div>
         <div class="col-sm-2">
            <div class="form-group">
               <div class="input-group">
                  <input class="form-control" type="text" id="tpvmod-cliente-activo" value="{{ fsc.cliente ? fsc.cliente.nombre : '' }}" placeholder="Cualquier cliente" readonly="readonly"/>
                  {% if fsc.cliente %}
                  <span class="input-group-btn">
                     <a class="btn btn-default" href="{{ fsc.list_url({'codcliente': '', 'mostrar': 'buscar', 'offset': 0}) }}"
                        hx-get="{{ fsc.list_url({'codcliente': '', 'mostrar': 'buscar', 'offset': 0}) }}"
                        hx-target="#tpvmod-facturas-region" hx-select="#tpvmod-facturas-region"
                        hx-swap="outerHTML" hx-push-url="true" hx-trigger="click" title="Quitar filtro">
                        <span class="glyphicon glyphicon-remove"></span>
                     </a>
                  </span>
                  {% endif %}
               </div>
            </div>
         </div>
         <div class="col-sm-2">
            <div class="form-group">
               <input type="date" name="desde" value="{{ fsc.desde|date_iso }}" class="form-control" placeholder="Desde" autocomplete="off"
                      hx-get="{{ fsc.list_url({'mostrar': 'buscar', 'offset': 0}, ['desde']) }}"
                      hx-target="#tpvmod-facturas-region" hx-select="#tpvmod-facturas-region"
                      hx-swap="outerHTML" hx-push-url="true" hx-trigger="change"/>
            </div>
         </div>
         <div class="col-sm-2">
            <div class="form-group">
               <input type="date" name="hasta" value="{{ fsc.hasta|date_iso }}" class="form-control" placeholder="Hasta" autocomplete="off"
                      hx-get="{{ fsc.list_url({'mostrar': 'buscar', 'offset': 0}, ['hasta']) }}"
                      hx-target="#tpvmod-facturas-region" hx-select="#tpvmod-facturas-region"
                      hx-swap="outerHTML" hx-push-url="true" hx-trigger="change"/>
            </div>
         </div>
      </div>
   </div>
</form>
{% endif %}

<div id="tpvmod-facturas-region" x-data="tpvmodListado" x-bind:class="regionClass()">
   <div class="tpvmod-list-toolbar text-right">
      <div class="btn-group">
         <button type="button" class="btn btn-sm btn-default dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <span class="glyphicon glyphicon-sort-by-attributes-alt" aria-hidden="true"></span>
         </button>
         <ul class="dropdown-menu dropdown-menu-right">
            <li>
                <a href="{{ fsc.list_url({'order': 'fecha_desc', 'offset': 0}) }}"
                   hx-get="{{ fsc.list_url({'order': 'fecha_desc', 'offset': 0}) }}"
                   hx-target="#tpvmod-facturas-region" hx-select="#tpvmod-facturas-region"
                   hx-swap="outerHTML" hx-push-url="true" hx-trigger="click">
                  <span class="glyphicon glyphicon-sort-by-attributes-alt" aria-hidden="true"></span>
                  &nbsp; Fecha &nbsp;
                  {% if fsc.order == 'fecha DESC' %}<span class="glyphicon glyphicon-ok" aria-hidden="true"></span>{% endif %}
               </a>
            </li>
            <li>
                <a href="{{ fsc.list_url({'order': 'fecha_asc', 'offset': 0}) }}"
                   hx-get="{{ fsc.list_url({'order': 'fecha_asc', 'offset': 0}) }}"
                   hx-target="#tpvmod-facturas-region" hx-select="#tpvmod-facturas-region"
                   hx-swap="outerHTML" hx-push-url="true" hx-trigger="click">
                  <span class="glyphicon glyphicon-sort-by-attributes" aria-hidden="true"></span>
                  &nbsp; Fecha &nbsp;
                  {% if fsc.order == 'fecha ASC' %}<span class="glyphicon glyphicon-ok" aria-hidden="true"></span>{% endif %}
               </a>
            </li>
            <li>
                <a href="{{ fsc.list_url({'order': 'vencimiento_desc', 'offset': 0}) }}"
                   hx-get="{{ fsc.list_url({'order': 'vencimiento_desc', 'offset': 0}) }}"
                   hx-target="#tpvmod-facturas-region" hx-select="#tpvmod-facturas-region"
                   hx-swap="outerHTML" hx-push-url="true" hx-trigger="click">
                  <span class="glyphicon glyphicon-sort-by-attributes-alt" aria-hidden="true"></span>
                  &nbsp; Vencimiento &nbsp;
                  {% if fsc.order == 'vencimiento DESC' %}<span class="glyphicon glyphicon-ok" aria-hidden="true"></span>{% endif %}
               </a>
            </li>
            <li>
                <a href="{{ fsc.list_url({'order': 'vencimiento_asc', 'offset': 0}) }}"
                   hx-get="{{ fsc.list_url({'order': 'vencimiento_asc', 'offset': 0}) }}"
                   hx-target="#tpvmod-facturas-region" hx-select="#tpvmod-facturas-region"
                   hx-swap="outerHTML" hx-push-url="true" hx-trigger="click">
                  <span class="glyphicon glyphicon-sort-by-attributes" aria-hidden="true"></span>
                  &nbsp; Vencimiento &nbsp;
                  {% if fsc.order == 'vencimiento ASC' %}<span class="glyphicon glyphicon-ok" aria-hidden="true"></span>{% endif %}
               </a>
            </li>
         </ul>
      </div>
   </div>

<ul class="nav nav-tabs" role="tablist">
   <li{% if fsc.mostrar == 'todo' %} class="active"{% endif %}>
      <a href="{{ fsc.list_url({'mostrar': 'todo', 'offset': 0}) }}"
         hx-get="{{ fsc.list_url({'mostrar': 'todo', 'offset': 0}) }}"
         hx-target="#tpvmod-facturas-region" hx-select="#tpvmod-facturas-region"
         hx-swap="outerHTML" hx-push-url="true" hx-trigger="click">
         Todas las {% if defined('FS_FACTURAS') %}{{ constant('FS_FACTURAS') }}{% endif %}
      </a>
   </li>
   <li{% if fsc.mostrar == 'sinpagar' %} class="active"{% endif %}>
      <a href="{{ fsc.list_url({'mostrar': 'sinpagar', 'offset': 0}) }}"
         hx-get="{{ fsc.list_url({'mostrar': 'sinpagar', 'offset': 0}) }}"
         hx-target="#tpvmod-facturas-region" hx-select="#tpvmod-facturas-region"
         hx-swap="outerHTML" hx-push-url="true" hx-trigger="click">
         <span class="glyphicon glyphicon-pushpin"></span>
         <span class="hidden-xs">&nbsp; Sin pagar</span>
         <span class="hidden-xs badge">{{ fsc.total_sinpagar() }}</span>
      </a>
   </li>
   <li{% if fsc.mostrar == 'buscar' %} class="active"{% endif %}>
      <a href="{{ fsc.list_url({'mostrar': 'buscar', 'offset': 0}) }}"
         hx-get="{{ fsc.list_url({'mostrar': 'buscar', 'offset': 0}) }}"
         hx-target="#tpvmod-facturas-region" hx-select="#tpvmod-facturas-region"
         hx-swap="outerHTML" hx-push-url="true" hx-trigger="click" title="Buscar">
         <span class="glyphicon glyphicon-search"></span>
         {% if fsc.num_resultados != '' %}
         <span class="hidden-xs badge">{{ fsc.num_resultados }}</span>
         {% endif %}
      </a>
   </li>
</ul>

<div class="table-responsive">
   <table class="table table-hover">
      <thead>
         <tr>
            <th></th>
            <th></th>
            <th class="text-left">Código + {% if defined('FS_NUMERO2') %}{{ constant('FS_NUMERO2') }}{% endif %}</th>
            <th class="text-left">Cliente</th>
            <th class="text-left hidden-sm">Teléfono</th>
            <th class="text-left hidden-sm">Ciudad</th>
            <th class="text-left">Observaciones</th>
            <th class="text-right">Total</th>
            {% if fsc.codagente != '' %}
            <th class="text-right">Comisión</th>
            <th class="text-left">%</th>
            {% endif %}
            <th class="text-right">Fecha</th>
            <th class="text-right">Vencimiento</th>
         </tr>
      </thead>
      {% for value in fsc.resultados %}
      <tr class="clickableRow {% if value.vencida() or value.anulada %}danger{% elseif value.pagada %}success{% elseif value.total <= 0 %}warning{% endif %}" href="./index.php?page=tpvmod&amp;edita=factura&amp;id={{ value.idfactura }}">
         <td class="text-center">
            {% if value.pagada %}
            <span class="glyphicon glyphicon-ok" title="La {% if defined('FS_FACTURA') %}{{ constant('FS_FACTURA') }}{% endif %} está pagada"></span>
            {% endif %}
            {% if value.anulada %}
            <span class="glyphicon glyphicon-remove" title="La {% if defined('FS_FACTURA') %}{{ constant('FS_FACTURA') }}{% endif %} está anulada"></span>
            {% endif %}
            {% if value.idfacturarect %}
            <span class="glyphicon glyphicon-flag" title="{% if defined('FS_FACTURA_RECTIFICATIVA') %}{{ constant('FS_FACTURA_RECTIFICATIVA') }}{% endif %} de {{ value.codigorect }}"></span>
            {% endif %}
            {% if value.femail %}
            <span class="glyphicon glyphicon-send" title="La {% if defined('FS_FACTURA') %}{{ constant('FS_FACTURA') }}{% endif %} fue enviada por email el {{ value.femail }}"></span>
            {% endif %}
         </td>
         <td class="text-center">
            {% if value.idasiento %}
            <span class="glyphicon glyphicon-paperclip" title="La {% if defined('FS_FACTURA') %}{{ constant('FS_FACTURA') }}{% endif %} tiene vinculado un asiento contable"></span>
            {% endif %}
         </td>
         <td><a href="./index.php?page=tpvmod&amp;edita=factura&amp;id={{ value.idfactura }}">{{ value.codigo }}</a> {{ value.numero2 }}</td>
         <td>
            {{ value.nombrecliente }}
             <a href="{{ fsc.url()|raw }}&amp;codcliente={{ value.codcliente }}" class="cancel_clickable" title="Ver más {% if defined('FS_FACTURAS') %}{{ constant('FS_FACTURAS') }}{% endif %} de {{ value.nombrecliente }}">[+]</a>
         </td>
         <td class="hidden-sm">{{ fsc.telefono_cliente(value.codcliente) }}</td>
         <td class="hidden-sm">{{ value.ciudad }}</td>
         <td>{{ value.observaciones_resume() }}</td>
         <td class="text-right">{{ fsc.show_precio(value.total, value.coddivisa) }}</td>
         {% if fsc.codagente != '' %}
         <td class="text-right info">
            {{ fsc.show_precio(value.neto * value.porcomision / 100, value.coddivisa) }}
         </td>
         <td class="text-left">{{ fsc.show_numero(value.porcomision) }}</td>
         {% endif %}
         <td class="text-right" title="{{ value.hora }}">
            {% if value.fecha == fsc.today() %}<b>{{ value.fecha }}</b>{% else %}{{ value.fecha }}{% endif %}
         </td>
         <td class="text-right">
            {% if value.vencimiento == fsc.today() %}<b>{{ value.vencimiento }}</b>{% else %}{{ value.vencimiento }}{% endif %}
         </td>
      </tr>
      {% else %}
      <tr class="warning">
         <td></td>
         <td></td>
          <td colspan="8">Ninguna {% if defined('FS_FACTURA') %}{{ constant('FS_FACTURA') }}{% endif %} encontrada. Pulsa <b>Nueva</b> para crear una.</td>
         {% if fsc.codagente != '' %}
         <td></td>
         <td></td>
         {% endif %}
      </tr>
      {% endfor %}
      {% if fsc.total_resultados != '' %}
      <tr>
          <td colspan="8" class="text-right">
             {{ fsc.total_resultados_txt }} &nbsp; <b>{{ fsc.show_precio(fsc.total_resultados) }}</b>
          </td>
         {% if fsc.codagente != '' %}
         <td class="text-right"><b>{{ fsc.show_precio(fsc.total_resultados_comision) }}</b></td>
         <td></td>
         {% endif %}
         <td colspan="2"></td>
      </tr>
      {% endif %}
   </table>
</div>

<div class="container-fluid">
   <div class="row">
      <div class="col-sm-12 text-center">
         <ul class="pagination">
            {% for value in fsc.paginas() %}
            <li{% if value['actual'] %} class="active"{% endif %}>
               <a href="{{ value['url']|raw }}"
                  hx-get="{{ value['url'] }}"
                  hx-target="#tpvmod-facturas-region" hx-select="#tpvmod-facturas-region"
                  hx-swap="outerHTML" hx-push-url="true" hx-trigger="click">{{ value['num'] }}</a>
            </li>
            {% endfor %}
            </ul>
         </div>
      </div>
   </div>
</div>

<div class="modal fade" id="modal_huecos">
   <div class="modal-dialog">
      <div class="modal-content">
         <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h4 class="modal-title">
               <span class="glyphicon glyphicon-exclamation-sign"></span>
               &nbsp; Huecos en la facturación
            </h4>
            <p class="help-block">
               Si hay huecos en la facturación es debido a que faltan facturas.
            </p>
         </div>
         <div class="table-responsive">
            <table class="table table-hover">
               <thead>
                  <tr>
                     <th class="text-center">Código</th>
                     <th class="text-center">Fecha y hora</th>
                  </tr>
               </thead>
               {% for value in fsc.huecos %}
               <tr class="warning">
                  <td class="text-center">{{ value.codigo }}</td>
                  <td class="text-center">{{ value.fecha }} {{ value.hora }}</td>
               </tr>
               {% else %}
               <tr class="success">
                  <td colspan="2">No hay huecos en la numeración de {% if defined('FS_FACTURAS') %}{{ constant('FS_FACTURAS') }}{% endif %}. Eso es bueno ;-)</td>
               </tr>
               {% endfor %}
            </table>
         </div>
      </div>
   </div>
</div>

<form class="form" role="form" id="f_buscar_lineas" name="f_buscar_lineas" action="{{ fsc.url()|raw }}" method="post"
      hx-post="{{ fsc.url() }}" hx-target="#search_results" hx-swap="innerHTML"
      hx-trigger="submit" hx-sync="this:replace">
   {{ csrf_field() }}
   <input type="hidden" name="offset" value="0"/>
   <div class="modal" id="modal_buscar_lineas">
      <div class="modal-dialog" style="width: 99%; max-width: 950px;">
         <div class="modal-content">
            <div class="modal-header">
               <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
               <h4 class="modal-title">Buscar en las líneas</h4>
               {% if fsc.cliente %}
               <p class="help-block">
                  Estas buscando en las líneas de las {% if defined('FS_FACTURAS') %}{{ constant('FS_FACTURAS') }}{% endif %} de {{ fsc.cliente.nombre }}.
               </p>
               {% else %}
               <p class="help-block">Si quieres, puede <a href="{{ fsc.url()|raw }}&amp;mostrar=buscar">filtrar por cliente</a>.</p>
               {% endif %}
            </div>
            <div class="modal-body">
               {% if fsc.cliente %}
               <input type="hidden" name="codcliente" value="{{ fsc.cliente.codcliente }}"/>
               <div class="container-fluid">
                  <div class="row">
                     <div class="col-lg-6 col-md-6 col-sm-6">
                        <div class="input-group">
                           <input class="form-control" type="text" name="buscar_lineas" placeholder="Referencia" autocomplete="off"
                                  hx-post="{{ fsc.url() }}" hx-target="#search_results" hx-swap="innerHTML"
                                  hx-trigger="keyup changed delay:300ms" hx-sync="closest form:replace"/>
                           <span class="input-group-btn">
                              <button class="btn btn-primary" type="submit">
                                 <span class="glyphicon glyphicon-search"></span>
                              </button>
                           </span>
                        </div>
                     </div>
                     <div class="col-lg-6 col-md-6 col-sm-6">
                        <div class="form-group">
                           <input class="form-control" type="text" name="buscar_lineas_o" placeholder="Observaciones" autocomplete="off"
                                  hx-post="{{ fsc.url() }}" hx-target="#search_results" hx-swap="innerHTML"
                                  hx-trigger="keyup changed delay:300ms" hx-sync="closest form:replace"/>
                        </div>
                     </div>
                  </div>
               </div>
               {% else %}
               <div class="input-group">
                  <input class="form-control" type="text" name="buscar_lineas" placeholder="Referencia" autocomplete="off"
                         hx-post="{{ fsc.url() }}" hx-target="#search_results" hx-swap="innerHTML"
                         hx-trigger="keyup changed delay:300ms" hx-sync="closest form:replace"/>
                  <span class="input-group-btn">
                     <button class="btn btn-primary" type="submit">
                        <span class="glyphicon glyphicon-search"></span>
                     </button>
                  </span>
               </div>
               {% endif %}
            </div>
            <div id="search_results" class="table-responsive"></div>
         </div>
      </div>
   </div>
</form>

{# Alpine CSP registration — nonce'd classic script, idempotent via window
   markers because htmx re-executes swapped scripts. Exactly one
   htmx:after:swap listener re-initializes the swapped region. #}
<script {{ csp_nonce_attr() }}>
(function () {
   if (window.__tpvmodListadoRegistered === true) { return; }

   function registerTpvmodListado() {
      if (window.__tpvmodListadoRegistered === true) { return; }
      window.__tpvmodListadoRegistered = true;

      Alpine.data('tpvmodListado', function () {
         return {
            loading: false,
            regionClass: function () {
               return 'tpvmod-region' + (this.loading ? ' is-loading' : '');
            }
         };
      });
   }

   if (window.Alpine) {
      registerTpvmodListado();
   } else {
      document.addEventListener('alpine:init', registerTpvmodListado);
   }
})();

(function () {
   if (window.__tpvmodListadoSwapBound === true) { return; }
   window.__tpvmodListadoSwapBound = true;

   document.addEventListener('htmx:after:swap', function (evt) {
      if (!window.Alpine || typeof window.Alpine.initTree !== 'function') { return; }
      var ctx = evt && evt.detail ? evt.detail.ctx : null;
      window.Alpine.initTree(ctx && ctx.target ? ctx.target : document.body);
   });
})();
</script>

{{ alpine.boot() }}

