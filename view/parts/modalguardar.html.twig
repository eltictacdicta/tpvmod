{#
/**
 * Plugin: tpvmod
 * Partial — modal de "Guardar ticket" usado por tpvmodedita.
 * Esta parcial NO incluye csrf_field porque ya está en el <form> padre.
 * Twig nativo (no depende de legacy_support).
 * Migrado desde view/parts/modalguardar.html el 2026-07-18.
 */
#}
   <div class="modal" id="modal_guardar" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
      <div class="modal-dialog">
         <div class="modal-content">
            <div class="modal-header">
               <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                  <span aria-hidden="true">&times;</span>
               </button>
               <h4 class="modal-title" id="myModalLabel">Guardar ticket</h4>
            </div>
            <div class="modal-body">
               <div class="form-group col-md-6">
               <div class="form-group">
                  Total:
                  <input type="text" name="tpv_total" id="tpv_total" class="form-control" disabled="disabled"/>
               </div>
               <div class="form-group">
                  Efectivo:
                  <input type="text" name="tpv_efectivo" id="tpv_efectivo" class="form-control" onkeyup="recalcular()" autocomplete="off"/>
               </div>
               <div class="form-group">
                  Cambio:
                  <input type="text" name="tpv_cambio" id="tpv_cambio" class="form-control" disabled="disabled"/>
               </div>

               </div>

               <div class="radio col-md-6">
               Guardar
               </div>
               {% for tipo in fsc.tipos_a_guardar() %}
               {% if fsc.vienede == tipo.tipo %}

               <div class="radio col-md-6">
                  <label>
                     <input type="radio" name="tipo" value="guardar_{{ tipo.tipo }}" checked="checked" />
                     Guardar {{ tipo.tipo }}
                  </label>
               </div>
               {% endif %}
               {% endfor %}
               <div class="radio col-md-6">
               Generar documento nuevo
               </div>
               {% for tipo in fsc.tipos_a_guardar() %}
               <div class="radio col-md-6">
                  <label>
                     <input type="radio" name="tipo" value="{{ tipo.tipo }}" />
                     {{ tipo.nombre }}
                  </label>
               </div>
               {% endfor %}
               <div class="form-group col-md-12">
                  <a href="{{ fsc.forma_pago.url()|raw }}">Forma de pago</a>:
                  <select name="forma_pago" class="form-control">
                  {% for fp in fsc.forma_pago.all() %}
                     {% if fp.is_default() %}
                     <option value="{{ fp.codpago }}" selected="selected">{{ fp.descripcion }}</option>
                     {% else %}
                     <option value="{{ fp.codpago }}">{{ fp.descripcion }}</option>
                     {% endif %}
                  {% endfor %}
                  </select>
               </div>
            </div>
            <div class="modal-footer">
               <div class="form-group col-md-12">
               <button class="btn btn-sm btn-primary" type="submit" onclick="this.disabled=true;$('#tpv_total').prop('disabled',false);this.form.submit();">
                  <span class="glyphicon glyphicon-floppy-disk"></span> &nbsp; Guardar
               </button>
               </div>
            </div>
         </div>
      </div>
   </div>
