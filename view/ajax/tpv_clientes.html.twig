{# tpvmod — AJAX client search results for modal #}
<!--{{ fsc.query }}-->

{% if fsc.get_errors() %}
<div class="alert alert-danger">
   <ul>{% for value in fsc.get_errors() %}<li>{{ value }}</li>{% endfor %}</ul>
</div>
{% endif %}

{% if fsc.results %}
<div class="table-responsive">
   <table class="table table-hover table-condensed">
      <thead>
         <tr>
            <th>Nombre</th>
            <th>CIF/NIF</th>
            <th>Teléfono</th>
         </tr>
      </thead>
      <tbody>
         {% for cli in fsc.results %}
         <tr class="clickable" style="cursor:pointer"
             onclick="tpvmodSeleccionarCliente('{{ cli.codcliente|e('js') }}', '{{ cli.nombre|e('js') }}', '{{ cli.cifnif|e('js') }}', '{{ cli.telefono1|e('js') }}')">
            <td>{{ cli.nombre }}</td>
            <td>{{ cli.cifnif }}</td>
            <td>{{ cli.telefono1 ?: cli.telefono2 }}</td>
         </tr>
         {% endfor %}
      </tbody>
   </table>
</div>
{% else %}
<div class="alert alert-info">Sin resultados</div>
{% endif %}
