{# FS_PEDIDO — ajax line search results for tpvmod_pedidos #}
<!--{{ fsc.buscar_lineas }}-->

{% if fsc.get_errors() %}
   <div class="alert alert-danger">
      {% for value in fsc.get_errors() %}<li>{{ value }}</li>{% endfor %}
   </div>
{% endif %}
{% if fsc.get_messages() %}
   <div class="alert alert-success">
      {% for value in fsc.get_messages() %}<li>{{ value }}</li>{% endfor %}
   </div>
{% endif %}

<table class="table table-hover">
   <thead>
      <tr>
         <th class="text-left text-capitalize">{% if defined('FS_PEDIDO') %}{{ constant('FS_PEDIDO') }}{% endif %}</th>
         <th class="text-right">Cantidad</th>
         <th class="text-left">Artículo</th>
         <th class="text-right">Total+{% if defined('FS_IVA') %}{{ constant('FS_IVA') }}{% endif %}</th>
         <th class="text-right" width="90">Fecha</th>
      </tr>
   </thead>
   {% for value in fsc.lineas %}
   <tr{% if value.cantidad <= 0 %} class="warning"{% endif %}>
      <td><a target="_blank" href="{{ value.url() }}">{{ value.show_codigo() }}</a></td>
      <td class="text-right">{{ value.cantidad }}</td>
      <td><a target="_blank" href="{{ value.articulo_url() }}">{{ value.referencia }}</a> {{ value.descripcion }}</td>
      <td class="text-right">{{ fsc.show_precio(value.total_iva()) }}</td>
      <td class="text-right">{{ value.show_fecha() }}</td>
   </tr>
   {% else %}
   <tr class="warning">
      <td colspan="5">Sin resultados.</td>
   </tr>
   {% endfor %}
</table>

{% if fsc.lineas %}
<ul class="pager">
   {% if fsc.offset > 0 %}
   <li class="previous">
      <a href="#" onclick="mas_resultados('-{{ fsc.lineas|length }}')">
         <span class="glyphicon glyphicon-chevron-left"></span> &nbsp; Anteriores
      </a>
   </li>
   {% endif %}
   {% if fsc.lineas|length == constant('FS_ITEM_LIMIT') %}
   <li class="next">
      <a href="#" onclick="mas_resultados('{{ fsc.lineas|length }}')">
         Siguientes &nbsp; <span class="glyphicon glyphicon-chevron-right"></span>
      </a>
   </li>
   {% endif %}
</ul>
{% endif %}
