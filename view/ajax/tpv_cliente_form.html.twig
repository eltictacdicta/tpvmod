{# tpvmod — client create/edit form loaded inside modal (tabs) #}
{% set cliente = fsc.tpv_cliente %}
{% set es_nuevo = fsc.tpv_cliente_nuevo %}

{% if fsc.get_errors() %}
<div class="alert alert-danger">
   <ul>{% for value in fsc.get_errors() %}<li>{{ value }}</li>{% endfor %}</ul>
</div>
{% endif %}

{#
   The identity fields and the discount block belong to the shared cliente form
   authority (clientes_core). Both includes are captured so this view can detect
   the degraded state below: `ignore missing` leaves a capture empty when the
   `@clientes_core` namespace is not registered, instead of breaking the page.
#}
{% set fields_html %}
{% include '@clientes_core/Cliente/Fields.html.twig' ignore missing with {
   mode: es_nuevo ? 'create' : 'edit',
   cliente: cliente,
   grupos: fsc.tpv_grupos,
   regimenes_iva: fsc.tpv_regimenes_iva,
   id_prefix: 'tpv_cliente',
   input_class: 'form-control input-sm'
} %}
{% endset %}

{% set discounts_html %}
{% include '@clientes_core/Cliente/Discounts.html.twig' ignore missing with {
   cliente: cliente,
   grupos_descuentos: fsc.tpv_grupos_descuentos,
   id_prefix: 'tpv_cliente',
   input_class: 'form-control input-sm'
} %}
{% endset %}

{#
   Both rules are scoped to this modal, never global. `x-cloak` hides the
   Alpine-driven help until tpvmod-cliente.js decides (the TPV loads no Alpine);
   the reset button has no endpoint here, so it must not be visible at all.
#}
<style>
   #f_cliente_tpv [x-cloak] { display: none; }
   #f_cliente_tpv #tpv_cliente_btn_reset_descuentos { display: none; }
</style>

{% if fields_html|trim is empty %}
<div class="alert alert-warning">
   <i class="fa fa-exclamation-triangle"></i>
   {{ trans('tpv-cliente-form-sin-clientes-core') }}
</div>
{% else %}
<form id="f_cliente_tpv" name="f_cliente_tpv" class="form" onsubmit="return false;">
   {{ csrf_field() }}
   <input type="hidden" name="save_cliente_tpv" value="1"/>

   <ul class="nav nav-tabs" role="tablist">
      <li class="active"><a href="#tpv_cli_datos" role="tab" data-toggle="tab">Datos</a></li>
      <li><a href="#tpv_cli_descuentos" role="tab" data-toggle="tab">Descuentos</a></li>
      <li><a href="#tpv_cli_direcciones" role="tab" data-toggle="tab">Direcciones</a></li>
   </ul>

   <div class="tab-content" style="padding-top: 15px;">
      <div class="tab-pane active" id="tpv_cli_datos">
         {# Trusted plugin template output: the shared partial escapes its values. #}
         {{ fields_html|raw }}
      </div>

      <div class="tab-pane" id="tpv_cli_descuentos">
         {{ discounts_html|raw }}
      </div>

      <div class="tab-pane" id="tpv_cli_direcciones">
         {% if es_nuevo %}
         <div class="alert alert-info">Guarda el cliente primero para añadir direcciones.</div>
         {% else %}
         <div class="table-responsive">
            <table class="table table-condensed table-hover" id="tpv_tabla_direcciones">
               <thead>
                  <tr>
                     <th>Descripción</th>
                     <th>Dirección</th>
                     <th>Ciudad</th>
                     <th class="text-center">Envío</th>
                     <th class="text-center">Fact.</th>
                     <th></th>
                  </tr>
               </thead>
               <tbody>
                  {% for dir in fsc.tpv_direcciones %}
                  <tr>
                     <td>{{ dir.descripcion ?: '-' }}</td>
                     <td>{{ dir.direccion }}</td>
                     <td>{{ dir.ciudad ?: '-' }}</td>
                     <td class="text-center">{% if dir.domenvio %}<span class="glyphicon glyphicon-ok text-success"></span>{% endif %}</td>
                     <td class="text-center">{% if dir.domfacturacion %}<span class="glyphicon glyphicon-ok text-success"></span>{% endif %}</td>
                     <td class="text-right">
                        <button type="button" class="btn btn-xs btn-default" onclick="tpvmodEditarDireccion({{ dir.id }})">
                           <span class="glyphicon glyphicon-edit"></span>
                        </button>
                        <button type="button" class="btn btn-xs btn-danger" onclick="tpvmodEliminarDireccion({{ dir.id }})">
                           <span class="glyphicon glyphicon-trash"></span>
                        </button>
                     </td>
                  </tr>
                  {% else %}
                  <tr><td colspan="6" class="text-muted text-center">Sin direcciones</td></tr>
                  {% endfor %}
               </tbody>
            </table>
         </div>

         <h5>Nueva / editar dirección</h5>
         {# Not a <form>: the address controls ride inside the client form, so
            save_direccion_tpv keeps its own hidden codcliente. #}
         <div id="f_direccion_tpv" class="form">
            <input type="hidden" name="save_direccion_tpv" value="1"/>
            <input type="hidden" name="codcliente" value="{{ cliente.codcliente }}"/>
            <input type="hidden" name="dir_id" id="tpv_dir_id" value=""/>
            <div class="row">
               <div class="col-sm-3">
                  <input type="text" name="descripcion" class="form-control input-sm" placeholder="Descripción" value="Principal"/>
               </div>
               <div class="col-sm-5">
                  <input type="text" name="direccion" class="form-control input-sm" placeholder="Dirección" required/>
               </div>
               <div class="col-sm-2">
                  <input type="text" name="codpostal" class="form-control input-sm" placeholder="C.P."/>
               </div>
               <div class="col-sm-2">
                  <input type="text" name="codpais" class="form-control input-sm" placeholder="País" value="ESP"/>
               </div>
            </div>
            <div class="row" style="margin-top: 8px;">
               <div class="col-sm-4">
                  <input type="text" name="ciudad" class="form-control input-sm" placeholder="Ciudad"/>
               </div>
               <div class="col-sm-4">
                  <input type="text" name="provincia" class="form-control input-sm" placeholder="Provincia"/>
               </div>
               <div class="col-sm-2">
                  <label class="checkbox-inline"><input type="checkbox" name="domenvio" value="1"/> Envío</label>
               </div>
               <div class="col-sm-2">
                  <label class="checkbox-inline"><input type="checkbox" name="domfacturacion" value="1" checked="checked"/> Fact.</label>
               </div>
            </div>
            <div class="text-right" style="margin-top: 8px;">
               <button type="button" class="btn btn-sm btn-primary" onclick="tpvmodGuardarDireccion()">
                  <span class="glyphicon glyphicon-floppy-disk"></span> Guardar dirección
               </button>
            </div>
         </div>
         {% endif %}
      </div>
   </div>

   <div class="text-right" style="margin-top: 15px; border-top: 1px solid #eee; padding-top: 10px;">
      <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">Cancelar</button>
      <button type="button" class="btn btn-sm btn-primary" onclick="tpvmodGuardarCliente()">
         <span class="glyphicon glyphicon-floppy-disk"></span> Guardar cliente
      </button>
   </div>
</form>

<script type="text/javascript">
   window.tpvDireccionesData = {{ fsc.tpv_direcciones|default([])|json_encode|raw }};
</script>
{% endif %}
