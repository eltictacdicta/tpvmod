{#
/**
 * Plugin: tpvmod
 * Pantalla admin-only para alternar el modo de selección de terminal
 * (with_terminal | without_terminal). Persistido en fs_settings.
 * Twig nativo (no depende de legacy_support).
 * Migrado desde view/tpvmod_settings.html el 2026-07-18.
 */
#}
{% include 'header.html.twig' %}

<div class="container">
   <div class="row">
      <div class="col-sm-6 col-sm-offset-3">
         <div class="page-header">
            <h1>TPVMOD — Modo de selección de terminal</h1>
         </div>

         {% if not fsc.terminal_settings_available %}
         <div class="alert alert-info">
            La gestión de caja y terminales requiere el plugin
            <strong>facturacion_base</strong> activo. Sin él, el TPV funciona
            en modo ventas directas (sin apertura de caja ni impresión vía
            <code>ventas_imprimir</code>).
         </div>
         {% else %}
         <form action="{{ fsc.url()|raw }}" method="post" class="form">
            {{ csrf_field() }}
            <div class="form-group">
               <label for="tpvmod_terminal_mode">Modo de selección</label>
               <select name="tpvmod_terminal_mode" id="tpvmod_terminal_mode" class="form-control">
                  <option value="with_terminal" {% if fsc.terminal_mode == 'with_terminal' %}selected{% endif %}>
                     Con terminal (los cajeros deben elegir un terminal)
                  </option>
                  <option value="without_terminal" {% if fsc.terminal_mode == 'without_terminal' %}selected{% endif %}>
                     Sin terminal (los cajeros pueden operar sin un terminal físico)
                  </option>
               </select>
            </div>
            <div class="text-right">
               <button class="btn btn-sm btn-primary" type="submit">
                  <span class="glyphicon glyphicon-floppy-disk"></span> &nbsp; Guardar
               </button>
            </div>
         </form>
         {% endif %}

         {#
          * Mapeo sede -> tipo de documento. Deliberadamente FUERA del gate de
          * terminal (que depende de facturacion_base): esta sección se renderiza
          * siempre que la página sea accesible.
          #}
         <div class="page-header">
            <h1>TPVMOD — Sede por tipo de documento</h1>
         </div>

         {% if not fsc.sede_mapping_available %}
         <div class="alert alert-info">
            El mapeo de sedes requiere el modelo <strong>empresa_sede</strong>
            del plugin <strong>business_data</strong>. Sin él, los documentos
            siguen usando la empresa base.
         </div>
         {% else %}
         <form action="{{ fsc.url()|raw }}" method="post" class="form">
            {{ csrf_field() }}
            <input type="hidden" name="save_sede_mapping" value="1" />

            <div class="form-group">
               <label for="sede_presupuesto">Presupuestos</label>
               <select name="sede_presupuesto" id="sede_presupuesto" class="form-control">
                  <option value="">Sin sustitución (empresa base)</option>
                  {% for sede in fsc.sedes %}
                  <option value="{{ sede.codsede }}" {% if fsc.sede_mapping.presupuesto == sede.codsede %}selected{% endif %}>{{ sede.descripcion ?: sede.nombre }}</option>
                  {% endfor %}
               </select>
            </div>

            <div class="form-group">
               <label for="sede_albaran">Albaranes</label>
               <select name="sede_albaran" id="sede_albaran" class="form-control">
                  <option value="">Sin sustitución (empresa base)</option>
                  {% for sede in fsc.sedes %}
                  <option value="{{ sede.codsede }}" {% if fsc.sede_mapping.albaran == sede.codsede %}selected{% endif %}>{{ sede.descripcion ?: sede.nombre }}</option>
                  {% endfor %}
               </select>
            </div>

            <div class="form-group">
               <label for="sede_pedido">Pedidos</label>
               <select name="sede_pedido" id="sede_pedido" class="form-control">
                  <option value="">Sin sustitución (empresa base)</option>
                  {% for sede in fsc.sedes %}
                  <option value="{{ sede.codsede }}" {% if fsc.sede_mapping.pedido == sede.codsede %}selected{% endif %}>{{ sede.descripcion ?: sede.nombre }}</option>
                  {% endfor %}
               </select>
            </div>

            <div class="form-group">
               <label for="sede_factura">Facturas</label>
               <select name="sede_factura" id="sede_factura" class="form-control">
                  <option value="">Sin sustitución (empresa base)</option>
                  {% for sede in fsc.sedes %}
                  <option value="{{ sede.codsede }}" {% if fsc.sede_mapping.factura == sede.codsede %}selected{% endif %}>{{ sede.descripcion ?: sede.nombre }}</option>
                  {% endfor %}
               </select>
            </div>

            <div class="text-right">
               <button class="btn btn-sm btn-primary" type="submit">
                  <span class="glyphicon glyphicon-floppy-disk"></span> &nbsp; Guardar
               </button>
            </div>
         </form>
         {% endif %}
      </div>
   </div>
</div>

{% include 'footer.html.twig' %}
